# ------------------------------------------------------------------
#  PLAG AI · Studio — configuration
#  Copie ce fichier en .env puis adapte les valeurs.
# ------------------------------------------------------------------

# Port de l'interface web (ouvre http://localhost:PORT)
PORT=3000
HOST=0.0.0.0

# Endpoint de l'API PLAG AI
PLAG_API_URL=http://127.0.0.1:8765/v1/chat

# Clé API. Si laissée vide, le serveur lit /etc/plag-ai/api.key
# (ou le fichier .plag-ai-key à la racine du projet).
PLAG_API_KEY=
# PLAG_API_KEY_FILE=/etc/plag-ai/api.key

# Délai maximum d'une réponse (ms)
PLAG_TIMEOUT_MS=300000
